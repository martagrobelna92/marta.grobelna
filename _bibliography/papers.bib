@techreport{its21,
  bibtex_show = {true},
  abbr        = {White paper},
  title       = {Trustworthy {AI} for Intelligent Traffic Systems ({ITS})},
  author      = {Bortoli, Stefano and Grossi, Margherita and Burton, Simon and Grobelna, Marta and Hagawara, Yuki and Schlei{\ss}, Philipp},
  institution = {Fraunhofer Institute for Cognitive Systems IKS, in cooperation with the Huawei Research Center Munich},
  year        = {2021},
  pdf         = {https://publica-rest.fraunhofer.de/server/api/core/bitstreams/47a07ed4-a7a9-4396-9d25-a11f1ebc849f/content},
  html        = {https://www.iks.fraunhofer.de/en/publications/whitepapers-studies/whitepaper-trustworthy-ai-intelligent-traffic-systems.html},
  abstract    = {AI-enabled Intelligent Traffic Systems (ITS) offer the potential to greatly improve the efficiency of traffic flow in inner cities, resulting in shorter travel times, increased fuel efficiency and reduction in harmful emissions. This white paper summarizes the results of consultations between safety, mobility and smart city experts, held as a roundtable event hosted by Fraunhofer IKS on 1 July 2021, and describes current and future challenges of introducing AI into Intelligent Traffic Systems in a trustworthy manner.}
}
